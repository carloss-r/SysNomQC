# ---- Conexión a Supabase (único lugar donde se cambia de BD) ----
# LOCAL (supabase start; los valores salen de `supabase status`):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon/publishable key local>
#   SUPABASE_SERVICE_ROLE_KEY=<service_role key local>
# PRODUCCIÓN (nube): Supabase > Project Settings > API; se configuran en el panel de Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Firebase Storage (opcional: ya hay valores por defecto en src/lib/firebase.ts)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Avisos de incidencias por correo (solo servidor; NO uses el prefijo NEXT_PUBLIC_)
RESEND_API_KEY=
INCIDENT_EMAIL_TO=crlos.trabajo.dev@gmail.com
INCIDENT_EMAIL_FROM=SysNomQC <onboarding@resend.dev>
# Combustibles alternos: destinatarios (separados por coma) del correo del semáforo SEMARNAT amarillo/rojo.
ECOLOGY_EMAIL_TO=

# Administración de usuarios (solo servidor; NUNCA con prefijo NEXT_PUBLIC_).
# Supabase > Project Settings > API > service_role key. Permite crear/editar/eliminar cuentas.
SUPABASE_SERVICE_ROLE_KEY=
